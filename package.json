{
  "name": "zerotouch",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "dev:app": "vite --mode desktop",
    "build:app": "vite build --mode desktop",
    "preview:app": "vite preview --mode desktop",
    "verify:separation": "node scripts/verify-separation.cjs",
    "desktop:build": "npm run build:app && cargo build --manifest-path desktop/Cargo.toml --locked",
    "desktop:test": "cargo test --manifest-path desktop/Cargo.toml --locked",
    "verify:tauri": "node scripts/verificar-tauri-real.mjs"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "vite": "^8.3.5"
  }
}
