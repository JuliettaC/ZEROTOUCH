    "pointer": true, "pinch": true, "drag": true, "scroll": true, "fistPause": true, "palm": true,
    "swipeLeft": false, "swipeRight": false, "thumbsUp": false, "thumbsDown": false, "precision": true, "airswipe": true
  },
  "ajustes_equipo": ["preferredHand", "mirrorCamera", "cameraIndex", "movementArea", "confidenceThreshold", "diagnosticOverlay", "windowGestures", "windowSwipe", "tabGestures", "rightClick", "dictation", "keyboardGesture", "altTab", "openHandScroll", "pointerAcceleration", "timerMinutes", "activeBox", "gaze"],
