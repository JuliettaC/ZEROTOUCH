    "modo_precision": { "nombre": "Modo precisión", "tipo": "discreto", "predeterminada": "precision", "acciones": ["navegacion", "atras", "adelante", "confirmar", "cancelar", "precision", "multimedia_play_pause", "multimedia_siguiente", "temporizador_iniciar"], "interruptor": "precision", "nota": "Postura: índice y meñique extendidos (medio y anular plegados) sostenida." },
    "trazo_airswipe": { "nombre": "Trazo en teclado Air-Swipe", "tipo": "modo", "predeterminada": "escritura_airswipe", "acciones": ["escritura_airswipe"], "interruptor": "airswipe" }
