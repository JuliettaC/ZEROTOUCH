          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"la versión sube una sola vez (2 → 3)\", () => { if (pm.response.json().data.version !== 3) throw new Error(\"version\"); });"
            ]
          }
        }
      ]
    },
    {
      "name": "18c Asignación inválida: no se aplica nada (ni el nombre)",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-CSRF-Token",
            "value": "{{csrf_token}}"
          }
        ],
        "url": "{{base_url}}/modos/{{modo_id}}",
        "body": {
