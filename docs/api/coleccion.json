            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 428: el borrado exige If-Match\", () => pm.response.to.have.status(428));"
            ]
          }
        }
      ]
    },
    {
      "name": "19d Borrar modo con ETag obsoleto",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-CSRF-Token",
            "value": "{{csrf_token}}"
          },
          {
            "key": "If-Match",
            "value": "\"AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA\""
          }
        ],
        "url": "{{base_url}}/modos/{{modo_id}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 412: no se borra nada\", () => pm.response.to.have.status(412));"
            ]
          }
