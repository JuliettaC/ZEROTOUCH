          "raw": "{\"version\":3,\"nombre\":\"No debe aplicarse\",\"gestos\":[{\"gesto_codigo\":\"no_existe\",\"accion_codigo\":\"sin_accion\",\"habilitado\":true}]}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 400\", () => pm.response.to.have.status(400));"
            ]
          }
        }
      ]
    },
    {
      "name": "18d El rechazo no cambió el modo",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/modos/{{modo_id}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"sigue con el nombre y la versión de 18b\", () => { const modo = pm.response.json().data; if (modo.nombre !== \"Manual con asignaciones\" || modo.version !== 3) throw new Error(\"el modo cambió\"); });"
            ]
          }
        }
      ]
    },
    {
