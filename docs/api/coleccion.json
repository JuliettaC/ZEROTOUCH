    {
      "name": "18b Editar modo con asignaciones (una sola solicitud, una sola subida de versión)",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-CSRF-Token",
            "value": "{{csrf_token}}"
          }
        ],
        "url": "{{base_url}}/modos/{{modo_id}}",
        "body": {
          "mode": "raw",
          "raw": "{\"version\":2,\"nombre\":\"Manual con asignaciones\",\"gestos\":[{\"gesto_codigo\":\"dos_dedos\",\"accion_codigo\":\"desplazar\",\"habilitado\":true},{\"gesto_codigo\":\"liberacion_pinza\",\"accion_codigo\":\"soltar\",\"habilitado\":false}]}",
          "options": {
