          {
            "key": "X-CSRF-Token",
            "value": "{{csrf_token}}"
          },
          {
            "key": "If-Match",
            "value": "{{etag_perfil}}"
          }
        ],
        "url": "{{base_url}}/perfiles/{{perfil_id}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 204\", () => pm.response.to.have.status(204));"
            ]
          }
        }
      ]
    },
    {
      "name": "23 Logout",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-CSRF-Token",
            "value": "{{csrf_token}}"
          }
        ],
        "url": "{{base_url}}/auth/logout"
      },
      "event": [
        {
          "listen": "test",
