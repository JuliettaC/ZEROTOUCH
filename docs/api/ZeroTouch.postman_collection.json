{
  "info": {
    "name": "ZeroTouch Hito 2 - CRUD y errores",
    "description": "Ejecutar en orden contra una base local de demostración. Crea sus propios registros y elimina solo esos IDs. Para persistencia, pausar después del paso 11, reiniciar el servidor y repetir 09/11 antes de continuar.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:3000"
    },
    {
      "key": "profileId",
      "value": ""
    },
    {
      "key": "contextId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "01 Salud",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/health"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ]
    },
    {
      "name": "02 Crear perfil",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/v1/profiles",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Demo ZeroTouch\",\n  \"gaze\": false\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 201', function () { pm.response.to.have.status(201); });",
              "pm.collectionVariables.set('profileId', pm.response.json().data.id);"
            ]
          }
        }
      ]
    },
    {
      "name": "03 Listar perfiles",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/v1/profiles?limit=20&offset=0"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ]
    },
    {
      "name": "04 Consultar perfil",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/v1/profiles/{{profileId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ]
    },
    {
      "name": "05 Actualizar perfil",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/v1/profiles/{{profileId}}",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"description\": \"Demostración API\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ]
    },
    {
      "name": "06 Verificar perfil actualizado",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/v1/profiles/{{profileId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', function () { pm.response.to.have.status(200); });",
              "pm.test('Descripción guardada', function () { pm.expect(pm.response.json().data.description).to.eql('Demostración API'); });"
            ]
          }
        }
      ]
    },
