NODE_ENV=development
HOST=127.0.0.1
PORT=3000
# Empty uses OS local data directory/ZeroTouch/development-v2.sqlite, outside OneDrive.
# Override only with an absolute local path outside synchronized/network folders.
DATABASE_PATH=
# Create once with npm --prefix backend run security:init; never commit the key.
ENCRYPTION_KEY_FILE=
APP_ORIGIN=http://127.0.0.1:3000
