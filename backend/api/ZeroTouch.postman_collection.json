{
  "info": {
    "name": "ZeroTouch v2 - autenticación, CRUD y errores",
    "description": "Solo demostración local. Define username y password de prueba; ejecutar en orden. Login obtiene cookie y CSRF. No usar credenciales reales en archivos compartidos. La cuenta demo permanece, los perfiles creados se eliminan.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:3000"
    },
    {
      "key": "profileId",
      "value": ""
    },
    {
      "key": "contextId",
      "value": ""
    },
    {
      "key": "username",
      "value": "postman_demo"
    },
    {
      "key": "password",
      "value": "Frase exclusivamente demo 2026!"
    },
    {
      "key": "cookie",
      "value": ""
    },
    {
      "key": "csrfToken",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "A Registro genérico",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/v2/auth/register",
        "body": {
          "mode": "raw",
          "raw": "{\"username\":\"{{username}}\",\"password\":\"{{password}}\"}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 202', function () { pm.response.to.have.status(202); });"
            ]
          }
        }
      ]
    },
    {
      "name": "B Iniciar sesión",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/v2/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\"username\":\"{{username}}\",\"password\":\"{{password}}\"}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', function () { pm.response.to.have.status(200); });",
              "pm.collectionVariables.set('cookie', pm.response.headers.get('set-cookie').split(';')[0]);",
              "pm.collectionVariables.set('csrfToken', pm.response.json().csrfToken);"
            ]
          }
        }
      ]
    },
    {
      "name": "01 Salud",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Cookie",
            "value": "{{cookie}}"
          },
          {
            "key": "X-CSRF-Token",
            "value": "{{csrfToken}}"
          }
        ],
        "url": "{{baseUrl}}/api/health"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ]
    },
